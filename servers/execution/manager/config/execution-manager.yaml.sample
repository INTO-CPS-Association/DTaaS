hostname: 127.0.0.1
port: 4004
# Set it to / to serve the routes at the root.
route-prefix: execution-manager
# Set the token with EXECUTION_MANAGER_GITLAB_TOKEN.
gitlab:
  url: https://gitlab.example.org
  username: user1
  # token: <personal access token with the api scope>
  group: DTaaS
  dt-directory: digital_twins
  common-library-project: common
  branch: master
  runner-tag: linux
# Set the password with EXECUTION_MANAGER_MQTT_PASSWORD.
mqtt:
  url: mqtt://localhost:1883
  # username: manager
  # password: <broker password>
  topic-prefix: dtaas/execution-manager
