{
  "name": "@into-cps-association/logger-ms",
  "version": "0.1.0",
  "description": "DTaaS logger microservice",
  "main": "dist/src/main.js",
  "repository": "https://github.com/into-cps-association/DTaaS.git",
  "author": "prasadtalasila",
  "contributors": [
    "Enok Maj"
  ],
  "license": "The INTO-CPS Association License",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "npx rimraf build node_modules coverage dist src.svg test.svg",
    "check:final": "concurrently -s all -g -n syntax,format,graph,build,test \"yarn syntax\" \"yarn format\" \"yarn graph\" \"yarn build\" \"yarn test\"",
    "format": "prettier --ignore-path .gitignore --write \"src/**/*.{ts,tsx,css,scss}\" \"test/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --ignore-path .gitignore --check \"src/**/*.{ts,tsx,css,scss}\" \"test/**/*.{ts,tsx,css,scss}\"",
    "graph": "npx madge --image src.svg src && npx madge --image test.svg test",
    "start": "npx cross-env NODE_OPTIONS=--es-module-specifier-resolution=node --experimental-specifier-resolution=node NODE_NO_WARNINGS=1 node dist/src/main.js",
    "syntax": "npx eslint . --fix",
    "syntax:check": "npx eslint .",
    "test": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=true",
    "test:e2e": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=true --verbose=true test/e2e",
    "test:nocov": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=false",
    "test:unit": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=true --verbose=true test/unit"
  },
  "bin": {
    "logger-ms": "./dist/src/main.js"
  },
  "files": [
    "dist/"
  ],
  "prettier": {
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "cross-env": "^10.1.0",
    "js-yaml": "^4.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}