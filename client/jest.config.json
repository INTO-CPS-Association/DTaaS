{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "transform": {
    "^.+\\.[tj]sx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "jsx": "react-jsx",
          "module": "commonjs",
          "moduleResolution": "node",
          "allowJs": true,
          "noUnusedLocals": false,
          "types": ["jest", "node", "react"],
          "esModuleInterop": true,
          "baseUrl": ".",
          "paths": {
            "*": ["./src/*"],
            "test/*": ["./test/*"],
            "@into-cps-association/dtaas-sdk/schema": [
              "node_modules/@into-cps-association/dtaas-sdk/dist/schema/index.d.ts"
            ],
            "@into-cps-association/dtaas-sdk/testing": [
              "node_modules/@into-cps-association/dtaas-sdk/dist/testing/index.d.ts"
            ]
          }
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(d3-shape|recharts|uuid|@into-cps-association/dt-automation|@into-cps-association/dtaas-sdk)/).+\\.js$"
  ],
  "collectCoverage": true,
  "coverageReporters": ["text", "cobertura", "clover", "lcov", "json"],
  "testTimeout": 15000,
  "collectCoverageFrom": ["src/**/*.{ts,tsx}"],
  "coveragePathIgnorePatterns": [
    "node_modules",
    "build",
    "src/index.tsx",
    "src/AppProvider.tsx",
    "src/store/store.ts",
    "src/preview/util/gitlabDriver.ts"
  ],
  "modulePathIgnorePatterns": ["test/e2e", "mocks", "<rootDir>/config/"],
  "coverageDirectory": "<rootDir>/coverage/",
  "globals": {
    "window.ENV.SERVER_HOSTNAME": "localhost",
    "window.ENV.SERVER_PORT": 3500
  },
  "verbose": true,
  "testRegex": "/test/.*\\.test.tsx?$",
  "modulePaths": ["<rootDir>/src/"],
  "moduleNameMapper": {
    "^test/(.*)$": "<rootDir>/test/$1",
    "\\.(css|less|scss)$": "<rootDir>/test/__mocks__/styleMock.ts",
    "^uuid$": "<rootDir>/test/__mocks__/uuidMock.ts",
    "^@into-cps-association/bim-kit/dtaas$": "<rootDir>/test/__mocks__/bimExtensionMock.tsx",
    "^@into-cps-association/dtaas-sdk/(schema|testing)$": "<rootDir>/node_modules/@into-cps-association/dtaas-sdk/dist/$1/index.js"
  },
  "maxWorkers": 3,
  "setupFiles": ["<rootDir>/test/setupTests.ts"]
}
