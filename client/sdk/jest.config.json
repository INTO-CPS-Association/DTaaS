{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "jsx": "react-jsx",
          "noUnusedLocals": false,
          "types": ["jest", "node"],
          "esModuleInterop": true,
          "paths": {
            "src/*": ["./src/*"],
            "tests/*": ["./tests/*"],
            "examples/*": ["./examples/*"],
            "@into-cps-association/dtaas-sdk": ["./src/index.ts"],
            "@into-cps-association/dtaas-sdk/*": ["./src/*/index.ts"]
          }
        }
      }
    ]
  },
  "collectCoverage": true,
  "coverageReporters": ["text", "cobertura", "clover", "lcov", "json"],
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.types.ts",
    "!src/index.ts",
    "!src/schema/index.ts",
    "!src/testing/index.ts"
  ],
  "testTimeout": 15000,
  "modulePathIgnorePatterns": ["dist", "<rootDir>/examples/bim"],
  "testRegex": "/tests/.*\\.test\\.tsx?$",
  "moduleDirectories": ["node_modules"],
  "modulePaths": ["<rootDir>"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^tests/(.*)$": "<rootDir>/tests/$1",
    "^examples/(.*)$": "<rootDir>/examples/$1",
    "^@into-cps-association/dtaas-sdk$": "<rootDir>/src/index.ts",
    "^@into-cps-association/dtaas-sdk/(.*)$": "<rootDir>/src/$1/index.ts",
    "\\.(css|less|scss)$": "<rootDir>/tests/__mocks__/styleMock.ts"
  },
  "verbose": true,
  "maxWorkers": 3,
  "setupFiles": ["<rootDir>/tests/setupTests.ts"]
}
