{
  "compilerOptions": {
    "noImplicitAny": true, // Raise errors for implicit any types.
    "allowSyntheticDefaultImports": true, // Allow default imports from modules without default exports.
    "sourceMap": true, // Generate source maps.
    "target": "ES2019",
    "lib": ["ES2019", "DOM", "DOM.Iterable", "ES2022.Error"],
    "types": [], // Keep the package free from test and UI framework globals.
    "module": "esnext", // Emit ES modules.
    "moduleResolution": "bundler", // Resolve imports as a bundler does.
    "declaration": true,
    "emitDeclarationOnly": true,
    "removeComments": true, // Remove comments from emitted declaration files.
    "noImplicitReturns": true, // Raise errors for functions without explicit returns on all paths.
    "noUnusedLocals": true, // Raise errors for unused local declarations.
    "noUnusedParameters": false, // Do not raise errors for unused parameters.
    "strict": true, // Enable strict type checking.
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "paths": {
      "src/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "exclude": ["**/node_modules/*", "dist"],
  "include": ["index.ts", "src/**/*.ts"]
}
