# Copy to .env, but generate the ids rather than trusting these comments:
#
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" > .env
#
# UID and GID must match your host account. They are baked into the image
# at build time, so changing user means rebuilding.
UID=
GID=

# Published host ports. Change only if something already uses them.
CLIENT_PORT=4000
LIBMS_PORT=4001
LOGGER_PORT=4003
DOCS_PORT=8000
