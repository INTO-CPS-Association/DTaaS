# developer/devenv/init.sh writes .env with your ids. Copy the port
# lines below into it only if you need to change them.
#
# UID and GID must match your host account. They are baked into the image
# at build time, so changing user means rebuilding.
UID=
GID=

# Published host ports. Change only if something already uses them.
CLIENT_PORT=4000
LIBMS_PORT=4001
LOGGER_PORT=4003
DOCS_PORT=8000
